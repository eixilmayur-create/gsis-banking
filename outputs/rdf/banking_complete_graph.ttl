ex:Branch a owl:Class ;
    rdfs:label "Branch" ;
    rdfs:comment """\r
    Physical banking branch.\r
    """ ;
    rdfs:subClassOf ex:Location .

<http://example.org/gsis/banking/data/Branch/BR005> a ex:Branch ;
    ex:branchCode "BR005"^^xsd:string .

<http://example.org/gsis/banking/data/Branch/BR010> a ex:Branch ;
    ex:branchCode "BR010"^^xsd:string .

<http://example.org/gsis/banking/data/Branch/BR015> a ex:Branch ;
    ex:branchCode "BR015"^^xsd:string .

ex:Merchant a owl:Class ;
    rdfs:label "Merchant" ;
    rdfs:comment """\r
    Business entity receiving payments for goods or services.\r
    """ ;
    rdfs:subClassOf ex:Party .

ex:FraudAlert a owl:Class ;
    rdfs:label "Fraud Alert" ;
    rdfs:comment """\r
    Risk event generated because suspicious financial activity\r
    was detected.\r
    """ ;
    rdfs:subClassOf ex:RiskEvent .

ex:RiskEvent a owl:Class ;
    rdfs:label "Risk Event" ;
    rdfs:comment """\r
    Event representing fraud, compliance, AML or other\r
    banking risk activity.\r
    """ .

ex:CashWithdrawal a owl:Class ;
    rdfs:label "Cash Withdrawal" ;
    rdfs:comment """\r
    Transaction representing withdrawal of cash from an account.\r
    """ ;
    rdfs:subClassOf ex:Transaction .

<http://example.org/gsis/banking/data/PaymentChannel/BRANCH> a ex:PaymentChannel ;
    ex:channelName "BRANCH"^^xsd:string .

<http://example.org/gsis/banking/data/PaymentChannel/MOBILE> a ex:PaymentChannel ;
    ex:channelName "MOBILE"^^xsd:string .

<http://example.org/gsis/banking/data/PaymentChannel/ATM> a ex:PaymentChannel ;
    ex:channelName "ATM"^^xsd:string .

<http://example.org/gsis/banking/data/PaymentChannel/WEB> a ex:PaymentChannel ;
    ex:channelName "WEB"^^xsd:string .

ex:CardTransaction a owl:Class ;
    rdfs:label "Card Transaction" ;
    rdfs:comment """\r
    Transaction initiated using a debit or credit card.\r
    """ ;
    rdfs:subClassOf ex:Transaction .

<http://example.org/gsis/banking/data/PaymentChannel/POS> a ex:PaymentChannel ;
    ex:channelName "POS"^^xsd:string .

ex:Card a owl:Class ;
    rdfs:label "Card" ;
    rdfs:comment """\r
    Payment card issued to a customer and typically linked to\r
    a banking account.\r
    """ ;
    rdfs:subClassOf ex:FinancialProduct .

ex:Customer a owl:Class ;
    rdfs:label "Customer" ;
    rdfs:comment """\r
    Individual or organisation maintaining a banking\r
    relationship with the institution.\r
    """ ;
    rdfs:subClassOf ex:Party ;
    owl:disjointWith ex:Merchant .

ex:Account a owl:Class ;
    rdfs:label "Account" ;
    rdfs:comment """\r
    Financial account maintained by the bank for a customer.\r
    """ ;
    rdfs:subClassOf ex:FinancialProduct .

ex:BankTransfer a owl:Class ;
    rdfs:label "Bank Transfer" ;
    rdfs:comment """\r
    Account-to-account financial transfer such as NEFT or IMPS.\r
    """ ;
    rdfs:subClassOf ex:Transaction .

ex:Transaction a owl:Class ;
    rdfs:label "Transaction" ;
    rdfs:comment """\r
    A financial event involving movement or transfer of value.\r
    """ .

