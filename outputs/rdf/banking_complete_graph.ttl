ex:TransactionTerminal a owl:Class ;
    rdfs:label "Transaction Terminal" ;
    rdfs:comment """\r
    Physical or electronic terminal used to perform a financial\r
    transaction, such as an ATM or POS terminal.\r
    """ ;
    rdfs:subClassOf ex:Location .

ex:concernsTransaction a owl:ObjectProperty ;
    rdfs:label "concerns transaction" ;
    rdfs:domain ex:RiskEvent ;
    rdfs:range ex:Transaction .

ex:heldBy a owl:ObjectProperty ;
    rdfs:label "held by" ;
    rdfs:domain ex:Account ;
    rdfs:range ex:Customer .

ex:initiatedBy a owl:ObjectProperty ;
    rdfs:label "initiated by" ;
    rdfs:domain ex:Transaction ;
    rdfs:range ex:Customer .

