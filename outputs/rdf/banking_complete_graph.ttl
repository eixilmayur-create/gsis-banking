@prefix ex: <http://example.org/gsis/banking#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:AMLAlert a owl:Class ;
    rdfs:label "AML Alert" ;
    rdfs:comment """\r
    Compliance event related to possible anti-money-laundering\r
    concerns.\r
    """ ;
    rdfs:subClassOf ex:RiskEvent .

ex:BankingOntology a owl:Ontology ;
    rdfs:label "GSIS Retail Banking Ontology" ;
    rdfs:comment """\r
    Semantic model used by the Graph Schema Intelligence System\r
    for retail banking schema mapping, validation, reuse,\r
    collision detection and ontology governance.\r
    """ .

ex:DigitalWallet a owl:Class ;
    rdfs:label "Digital Wallet" ;
    rdfs:comment """\r
    Digital financial wallet used to store value or initiate\r
    payments.\r
    """ ;
    rdfs:subClassOf ex:FinancialProduct .

ex:Loan a owl:Class ;
    rdfs:label "Loan" ;
    rdfs:comment """\r
    Credit facility provided to a borrower.\r
    """ ;
    rdfs:subClassOf ex:FinancialProduct .

ex:Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment """\r
    Legal or business organisation participating in banking\r
    activity.\r
    """ ;
    rdfs:subClassOf ex:Party .

ex:accountBalance a owl:DatatypeProperty ;
    rdfs:label "account balance" ;
    rdfs:domain ex:Account ;
    rdfs:range xsd:decimal .

ex:accountId a owl:DatatypeProperty ;
    rdfs:label "account id" ;
    rdfs:domain ex:Account ;
    rdfs:range xsd:string .

ex:accountStatus a owl:DatatypeProperty ;
    rdfs:label "account status" ;
    rdfs:domain ex:Account ;
    rdfs:range xsd:string .

ex:accountType a owl:DatatypeProperty ;
    rdfs:label "account type" ;
    rdfs:domain ex:Account ;
    rdfs:range xsd:string .

ex:branchCode a owl:DatatypeProperty ;
    rdfs:label "branch code" ;
    rdfs:domain ex:Branch ;
    rdfs:range xsd:string .

ex:cardId a owl:DatatypeProperty ;
    rdfs:label "card id" ;
    rdfs:domain ex:Card ;
    rdfs:range xsd:string .

ex:cardNetwork a owl:DatatypeProperty ;
    rdfs:label "card network" ;
    rdfs:domain ex:Card ;
    rdfs:range xsd:string .

ex:cardStatus a owl:DatatypeProperty ;
    rdfs:label "card status" ;
    rdfs:domain ex:Card ;
    rdfs:range xsd:string .

ex:cardType a owl:DatatypeProperty ;
    rdfs:label "card type" ;
    rdfs:domain ex:Card ;
    rdfs:range xsd:string .

ex:channelName a owl:DatatypeProperty ;
    rdfs:label "channel name" ;
    rdfs:domain ex:PaymentChannel ;
    rdfs:range xsd:string .

ex:concernsCustomer a owl:ObjectProperty ;
    rdfs:label "concerns customer" ;
    rdfs:domain ex:RiskEvent ;
    rdfs:range ex:Customer .

ex:currencyCode a owl:DatatypeProperty ;
    rdfs:label "currency code" ;
    rdfs:domain ex:Account ;
    rdfs:range xsd:string .

ex:customerId a owl:DatatypeProperty ;
    rdfs:label "customer id" ;
    rdfs:domain ex:Customer ;
    rdfs:range xsd:string .

ex:customerName a owl:DatatypeProperty ;
    rdfs:label "customer name" ;
    rdfs:domain ex:Customer ;
    rdfs:range xsd:string .

ex:customerSegment a owl:DatatypeProperty ;
    rdfs:label "customer segment" ;
    rdfs:domain ex:Customer ;
    rdfs:range xsd:string .

ex:dateOfBirth a owl:DatatypeProperty ;
    rdfs:label "date of birth" ;
    rdfs:domain ex:Customer ;
    rdfs:range xsd:date .

ex:email a owl:DatatypeProperty ;
    rdfs:label "email" ;
    rdfs:domain ex:Customer ;
    rdfs:range xsd:string .

ex:expiryYear a owl:DatatypeProperty ;
    rdfs:label "expiry year" ;
    rdfs:domain ex:Card ;
    rdfs:range xsd:integer .

ex:holdsCard a owl:ObjectProperty ;
    rdfs:label "holds card" ;
    rdfs:domain ex:Customer ;
    rdfs:range ex:Card .

ex:initiatesTransaction a owl:ObjectProperty ;
    rdfs:label "initiates transaction" ;
    rdfs:domain ex:Customer ;
    rdfs:range ex:Transaction ;
    owl:inverseOf ex:initiatedBy .

ex:investigationStatus a owl:DatatypeProperty ;
    rdfs:label "investigation status" ;
    rdfs:domain ex:RiskEvent ;
    rdfs:range xsd:string .

ex:kycStatus a owl:DatatypeProperty ;
    rdfs:label "KYC status" ;
    rdfs:domain ex:Customer ;
    rdfs:range xsd:string .

ex:linkedToAccount a owl:ObjectProperty ;
    rdfs:label "linked to account" ;
    rdfs:domain ex:Card ;
    rdfs:range ex:Account .

ex:merchantCategory a owl:DatatypeProperty ;
    rdfs:label "merchant category" ;
    rdfs:domain ex:Merchant ;
    rdfs:range xsd:string .

ex:merchantId a owl:DatatypeProperty ;
    rdfs:label "merchant id" ;
    rdfs:domain ex:Merchant ;
    rdfs:range xsd:string .

ex:mobileNumber a owl:DatatypeProperty ;
    rdfs:label "mobile number" ;
    rdfs:domain ex:Customer ;
    rdfs:range xsd:string .

ex:occurredAt a owl:ObjectProperty ;
    rdfs:label "occurred at" ;
    rdfs:domain ex:Transaction ;
    rdfs:range ex:Location .

ex:openedDate a owl:DatatypeProperty ;
    rdfs:label "opened date" ;
    rdfs:domain ex:Account ;
    rdfs:range xsd:date .

ex:ownsAccount a owl:ObjectProperty ;
    rdfs:label "owns account" ;
    rdfs:domain ex:Customer ;
    rdfs:range ex:Account ;
    owl:inverseOf ex:heldBy .

ex:paidTo a owl:ObjectProperty ;
    rdfs:label "paid to" ;
    rdfs:domain ex:Transaction ;
    rdfs:range ex:Merchant .

ex:riskEventId a owl:DatatypeProperty ;
    rdfs:label "risk event id" ;
    rdfs:domain ex:RiskEvent ;
    rdfs:range xsd:string .

ex:riskLevel a owl:DatatypeProperty ;
    rdfs:label "risk level" ;
    rdfs:domain ex:RiskEvent ;
    rdfs:range xsd:string .

ex:riskScore a owl:DatatypeProperty ;
    rdfs:label "risk score" ;
    rdfs:domain ex:RiskEvent ;
    rdfs:range xsd:decimal .

ex:riskType a owl:DatatypeProperty ;
    rdfs:label "risk type" ;
    rdfs:domain ex:RiskEvent ;
    rdfs:range xsd:string .

ex:servicedByBranch a owl:ObjectProperty ;
    rdfs:label "serviced by branch" ;
    rdfs:domain ex:Account ;
    rdfs:range ex:Branch .

ex:terminalId a owl:DatatypeProperty ;
    rdfs:label "terminal id" ;
    rdfs:domain ex:TransactionTerminal ;
    rdfs:range xsd:string .

ex:transactionAmount a owl:DatatypeProperty ;
    rdfs:label "transaction amount" ;
    rdfs:domain ex:Transaction ;
    rdfs:range xsd:decimal .

ex:transactionCurrency a owl:DatatypeProperty ;
    rdfs:label "transaction currency" ;
    rdfs:domain ex:Transaction ;
    rdfs:range xsd:string .

ex:transactionDate a owl:DatatypeProperty ;
    rdfs:label "transaction date" ;
    rdfs:domain ex:Transaction ;
    rdfs:range xsd:dateTime .

ex:transactionId a owl:DatatypeProperty ;
    rdfs:label "transaction id" ;
    rdfs:domain ex:Transaction ;
    rdfs:range xsd:string .

ex:transactionType a owl:DatatypeProperty ;
    rdfs:label "transaction type" ;
    rdfs:domain ex:Transaction ;
    rdfs:range xsd:string .

ex:triggeredRiskEvent a owl:ObjectProperty ;
    rdfs:label "triggered risk event" ;
    rdfs:domain ex:Transaction ;
    rdfs:range ex:RiskEvent ;
    owl:inverseOf ex:concernsTransaction .

ex:usesAccount a owl:ObjectProperty ;
    rdfs:label "uses account" ;
    rdfs:domain ex:Transaction ;
    rdfs:range ex:Account .

ex:usesChannel a owl:ObjectProperty ;
    rdfs:label "uses channel" ;
    rdfs:domain ex:Transaction ;
    rdfs:range ex:PaymentChannel .

